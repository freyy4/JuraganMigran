{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:funnel && vite build",
        "dev": "vite",
        "build:portal": "esbuild resources/js/portal/app.jsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/js/portal-react.js",
        "check:funnel": "tsc -p tsconfig.funnel.json",
        "build:funnel": "npm run check:funnel && esbuild resources/js/funnel-editor.ts --bundle --minify --format=esm --target=es2022 --legal-comments=inline --outfile=public/js/funnel-editor-engine.js"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "esbuild": "0.28.2",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "7.0.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "grapesjs": "0.23.8",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    }
}
